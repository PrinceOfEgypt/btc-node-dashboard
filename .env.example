# Copy this file to .env and fill in the RPC credentials before starting.
QUARKUS_HTTP_HOST=0.0.0.0
QUARKUS_HTTP_PORT=8081
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=replace-me
BITCOIN_RPC_SCHEME=http
WS_POLLING_INTERVAL=5
MIN_OUTBOUND_PEERS=8
DASHBOARD_CACHE_VALIDITY_BUFFER_MS=200
LOG_LEVEL=INFO
